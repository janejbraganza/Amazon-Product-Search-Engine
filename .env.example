# Optional settings for docker compose. Copy to ".env" (same folder) to override the
# defaults; ".env" is git-ignored, so never commit real passwords.
#
# Note: changing the PostgreSQL user/password/database only takes effect for a NEW data
# volume; an existing volume keeps the credentials it was created with.
# The password is used inside a database URL, so avoid the characters @ : / ? # % in it.

POSTGRES_USER=search_user
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=product_search

# Port of the complete application (http://localhost:8080)
APP_PORT=8080
