# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored, so never commit real passwords.

APP_ENV=development

# PostgreSQL (matches docker-compose.yml defaults for local development)
DATABASE_URL=postgresql+psycopg://search_user:change_me_local_dev@127.0.0.1:5432/product_search

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
